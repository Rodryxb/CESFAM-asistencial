# Configuración de Entorno - Sistema Web de Gestión Farmacia Asistencial CESFAM
DEBUG=True
SECRET_KEY=cesfam-minsal-isp-alcoa-secret-key-2026-aps-chile

# Motor de Base de Datos: 'postgresql' (Producción/Evaluación Híbrida SQL+JSONB GIN) o 'sqlite' (Fallback local rápido)
DB_ENGINE=postgresql
POSTGRES_DB=cesfam_farmacia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bus de Interoperabilidad HL7 FHIR MINSAL / FONASA
FHIR_BUS_ENDPOINT=https://interoperabilidad.minsal.cl/fhir/r4
CENABAST_API_ENDPOINT=https://api.cenabast.cl/v2/abastecimiento-aps
